{
  "name": "albion-loot-logger-desktop",
  "version": "0.4.3",
  "description": "Logiciel de tracking de loot pour la guilde — capture reseau (fork d'ao-loot-logger, GPL-3.0), envoie les events a un backend web pour comparaison avec le contenu du coffre.",
  "main": "src/index.js",
  "bin": "src/index.js",
  "private": true,
  "license": "GPL-3.0",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file=.env src/index.js",
    "package-release": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "dependencies": {
    "cap": "^0.2.1",
    "winston": "^3.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.14.2",
    "pe-library": "^2.0.1",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.1.0"
  },
  "pkg": {
    "targets": [
      "node20-win-x64"
    ],
    "assets": [
      "node_modules/cap/build/Release/cap.node"
    ]
  }
}
